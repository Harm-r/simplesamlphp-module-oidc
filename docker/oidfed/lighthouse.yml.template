entity_id: https://ta.127.0.0.1.nip.io:9443
server:
  port: 7672
signing:
  kms: filesystem
  pk_backend: db
  auto_generate_keys: true
  filesystem:
    key_dir: /data/keys
  alg: '@ALG@'
storage:
  driver: sqlite
  data_dir: /data
api:
  admin:
    enabled: true
    users_enabled: true
    port: 7673
federation_data:
  configuration_lifetime: 1h
  federation_entity_metadata:
    display_name: ML-DSA lab trust anchor
endpoints:
  fetch:
    path: /fetch
  list:
    path: /list
  resolve:
    path: /resolve
  auth:
    all_require_auth: false
